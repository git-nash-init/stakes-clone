{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(crash|plinko|dino|mines|dice|limbo|keno|hilo|blackjack|roulette|favourites|recent|challenges|my-bets)/?",
      "destination": { "service": "app", "path": "/index.html" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
